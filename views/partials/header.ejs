<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · 学习打卡</title>
  <link rel="stylesheet" href="/css/theme.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">学习打卡</div>
    <nav class="nav">
      <a href="/" class="<%= active === 'home' ? 'active' : '' %>">首页</a>
      <a href="/me" class="<%= active === 'me' ? 'active' : '' %>">个人中心</a>
      <a href="/duo" class="<%= active === 'duo' ? 'active' : '' %>">双人协作广场</a>
      <a href="/gallery" class="<%= active === 'gallery' ? 'active' : '' %>">全员打卡广场</a>
      <a href="/history" class="<%= active === 'history' ? 'active' : '' %>">历史记录</a>
    </nav>
    <div class="topbar-right">
      <% if (currentUser) { %>
        <div class="user-menu">
          <button type="button" id="userMenuBtn" class="user-menu-btn"
                  aria-haspopup="true" aria-expanded="false" aria-controls="userMenuList">
            <span class="avatar-sm" aria-hidden="true"><%= currentUser.nickname.slice(0, 1) %></span>
            <span class="user-menu-name"><%= currentUser.nickname %></span>
            <span class="caret" aria-hidden="true">▾</span>
          </button>
          <ul class="user-menu-list" id="userMenuList" hidden>
            <li>
              <a href="/me">
                个人中心
                <% if (currentUser.role === 'admin') { %><span class="badge badge-admin">管理员</span><% } %>
              </a>
            </li>
            <% if (currentUser.role === 'admin') { %>
              <li><a href="/admin">管理后台</a></li>
            <% } %>
            <li><button type="button" id="logoutBtn">登出</button></li>
          </ul>
        </div>
      <% } else { %>
        <a href="/login" class="btn btn-outline btn-sm">登录</a>
        <a href="/register" class="btn btn-primary btn-sm">注册</a>
      <% } %>
    </div>
  </header>

  <main class="container">
