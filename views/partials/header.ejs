<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · 学习打卡</title>
  <link rel="stylesheet" href="/css/theme.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">学习打卡</div>
    <nav class="nav">
      <a href="/" class="<%= active === 'home' ? 'active' : '' %>">首页</a>
      <a href="/me" class="<%= active === 'me' ? 'active' : '' %>">个人中心</a>
      <a href="/duo" class="<%= active === 'duo' ? 'active' : '' %>">双人协作广场</a>
      <a href="/gallery" class="<%= active === 'gallery' ? 'active' : '' %>">全员打卡广场</a>
      <a href="/history" class="<%= active === 'history' ? 'active' : '' %>">历史记录</a>
    </nav>
    <div class="topbar-right">
      <% if (currentUser) { %>
        <% if (currentUser.role === 'admin') { %>
          <span class="badge badge-admin">管理员</span>
        <% } %>
        <a href="/me" class="user-chip" title="进入个人中心"><%= currentUser.nickname %></a>
        <button type="button" id="logoutBtn" class="btn btn-outline btn-sm">登出</button>
      <% } else { %>
        <a href="/login" class="btn btn-outline btn-sm">登录</a>
        <a href="/register" class="btn btn-primary btn-sm">注册</a>
      <% } %>
    </div>
  </header>

  <main class="container">
