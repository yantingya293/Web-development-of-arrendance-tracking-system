<%- include('partials/header', { title, active: '' }) %>

  <section class="auth-wrap">
    <form id="authForm" class="card form-card" method="post" action="/api/auth/login" data-next="<%= next %>">
      <h2>登录</h2>

      <% if (registered) { %>
        <div class="alert alert-success">注册成功，请登录</div>
      <% } %>

      <div class="form-group">
        <label for="account">账号</label>
        <input id="account" name="account" type="text" autocomplete="username"
               placeholder="3–24 位字母、数字或下划线" required />
        <p class="field-error" data-error-for="account"></p>
      </div>

      <div class="form-group">
        <label for="password">密码</label>
        <input id="password" name="password" type="password" autocomplete="current-password"
               placeholder="请输入密码" required />
        <p class="field-error" data-error-for="password"></p>
      </div>

      <div class="alert alert-error" id="formError" hidden></div>

      <button type="submit" class="btn btn-primary btn-block">登 录</button>
      <p class="form-hint">还没有账号？<a href="/register">去注册</a></p>
    </form>
  </section>

<%- include('partials/footer') %>
<script src="/js/auth.js"></script>
