<%- include('partials/header', { title, active: 'me' }) %>

  <section class="card profile-card">
    <div class="profile-head">
      <div class="avatar"><%= currentUser.nickname.slice(0, 1) %></div>
      <div>
        <h2 class="profile-name">
          <%= currentUser.nickname %>
          <% if (currentUser.role === 'admin') { %><span class="badge badge-admin">管理员</span><% } %>
        </h2>
        <p class="muted">账号：<%= currentUser.account %> · 注册于 <%= currentUser.created_at %></p>
      </div>
    </div>

    <!-- Day 7：打卡数据速览（累计 / 今日 / 连续天数 + 近 7 天热度条） -->
    <div class="profile-stats">
      <div class="stat-card card">
        <p class="stat-value" id="statTotal">–</p>
        <p class="stat-label">累计打卡</p>
      </div>
      <div class="stat-card card">
        <p class="stat-value" id="statToday">–</p>
        <p class="stat-label">今日打卡</p>
      </div>
      <div class="stat-card card">
        <p class="stat-value" id="statStreak">–</p>
        <p class="stat-label">连续打卡（天）</p>
      </div>
    </div>

    <div class="profile-heatmap">
      <h3 class="profile-subtitle">近 7 天打卡热度</h3>
      <div class="heatmap-row" id="heatmapRow" aria-label="近 7 天每日打卡次数"></div>
      <p class="muted heatmap-hint" id="heatmapHint">加载中…</p>
      <p><a href="/history" class="btn btn-outline btn-sm">查看完整打卡历史</a></p>
    </div>

    <!-- Day 13：学习数据统计（任务完成率 / 分类分布 / 月度打卡日历） -->
    <div class="me-grid">
      <div class="card me-panel">
        <h3 class="profile-subtitle">任务完成率</h3>
        <div id="taskRatePanel">
          <div class="loading" role="status"><span class="spinner" aria-hidden="true"></span><p class="loading-text">加载中…</p></div>
        </div>
      </div>
      <div class="card me-panel">
        <h3 class="profile-subtitle">任务分类分布</h3>
        <div id="taskCatPanel">
          <div class="loading" role="status"><span class="spinner" aria-hidden="true"></span><p class="loading-text">加载中…</p></div>
        </div>
      </div>
    </div>

    <div class="card me-panel">
      <div class="cal-head">
        <h3 class="profile-subtitle">打卡日历</h3>
        <div class="cal-nav">
          <button type="button" class="btn btn-outline btn-sm" id="calPrevBtn" aria-label="上一个月">‹ 上月</button>
          <span class="cal-month" id="calMonth">–</span>
          <button type="button" class="btn btn-outline btn-sm" id="calNextBtn" aria-label="下一个月">下月 ›</button>
        </div>
      </div>
      <div id="calPanel">
        <div class="loading" role="status"><span class="spinner" aria-hidden="true"></span><p class="loading-text">加载中…</p></div>
      </div>
      <p class="muted cal-summary" id="calSummary"></p>
    </div>

    <!-- 安全加固：修改密码（成功后其他已登录设备全部退出） -->
    <div class="profile-password">
      <h3 class="profile-subtitle">修改密码</h3>
      <form id="pwdForm" novalidate>
        <div class="form-group">
          <label for="pwdOld">当前密码</label>
          <input type="password" id="pwdOld" name="oldPassword" autocomplete="current-password" required />
          <p class="field-error" data-error-for="oldPassword"></p>
        </div>
        <div class="form-group">
          <label for="pwdNew">新密码</label>
          <input type="password" id="pwdNew" name="newPassword" autocomplete="new-password"
                 placeholder="6–32 位，须同时包含字母和数字" required />
          <p class="field-error" data-error-for="newPassword"></p>
        </div>
        <button type="submit" class="btn btn-primary">确认修改</button>
        <p class="muted form-hint">修改成功后，其他已登录设备（含可能被盗的会话）会全部退出。</p>
      </form>
    </div>

    <div class="profile-placeholder">
      <p class="muted">个人中心继续建设中：</p>
      <ul class="muted">
        <li>组队信息 · 个人设置（头像 / 昵称修改）—— Day 14</li>
      </ul>
    </div>
  </section>

  <script src="/js/me.js" defer></script>

<%- include('partials/footer') %>
