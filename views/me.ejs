<%- include('partials/header', { title, active: 'me' }) %>

  <section class="card profile-card">
    <div class="profile-head">
      <div class="avatar"><%= currentUser.nickname.slice(0, 1) %></div>
      <div>
        <h2 class="profile-name">
          <%= currentUser.nickname %>
          <% if (currentUser.role === 'admin') { %><span class="badge badge-admin">管理员</span><% } %>
        </h2>
        <p class="muted">账号：<%= currentUser.account %> · 注册于 <%= currentUser.created_at %></p>
      </div>
    </div>

    <!-- Day 7：打卡数据速览（累计 / 今日 / 连续天数 + 近 7 天热度条） -->
    <div class="profile-stats">
      <div class="stat-card card">
        <p class="stat-value" id="statTotal">–</p>
        <p class="stat-label">累计打卡</p>
      </div>
      <div class="stat-card card">
        <p class="stat-value" id="statToday">–</p>
        <p class="stat-label">今日打卡</p>
      </div>
      <div class="stat-card card">
        <p class="stat-value" id="statStreak">–</p>
        <p class="stat-label">连续打卡（天）</p>
      </div>
    </div>

    <div class="profile-heatmap">
      <h3 class="profile-subtitle">近 7 天打卡热度</h3>
      <div class="heatmap-row" id="heatmapRow" aria-label="近 7 天每日打卡次数"></div>
      <p class="muted heatmap-hint" id="heatmapHint">加载中…</p>
      <p><a href="/history" class="btn btn-outline btn-sm">查看完整打卡历史</a></p>
    </div>

    <div class="profile-placeholder">
      <p class="muted">个人中心继续建设中：</p>
      <ul class="muted">
        <li>数据统计图表 · 组队信息 · 个人设置 —— Day 13 / 14</li>
      </ul>
    </div>
  </section>

  <script src="/js/me.js" defer></script>

<%- include('partials/footer') %>
