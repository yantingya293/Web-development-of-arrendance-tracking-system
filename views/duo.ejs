<%- include('partials/header', { title, active: 'duo' }) %>

  <section class="hero hero-compact">
    <div>
      <h1>双人协作广场</h1>
      <p class="sub">绑定学习搭档 · 共同任务 · 双方打卡互相监督</p>
    </div>
  </section>

  <% if (currentUser) { %>
    <!-- Day 8：组队绑定区（邀请 / 接受 / 拒绝 / 解绑） -->
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>我的搭档</h2>
          <span class="tag tag-duo">双人</span>
        </div>
      </div>
      <div class="section-body" id="duoTeamBody"
           data-my-account="<%= currentUser.account %>" data-my-nickname="<%= currentUser.nickname %>">
        <%- include('partials/components/loading', { text: '正在加载组队信息…' }) %>
      </div>
    </section>

    <!-- Day 11：协作数据（队伍统计 + 近 7 天双方打卡对比；组队后由脚本显示） -->
    <section class="card section-card" id="duoStatsSection" hidden>
      <div class="section-head">
        <div class="section-title">
          <h2>协作数据</h2>
          <span class="tag tag-duo">双人</span>
        </div>
      </div>
      <div class="section-body" id="duoStatsBody"></div>
    </section>

    <!-- Day 9：共同任务区（列表 + 新建 / 编辑弹窗 + 状态流转） -->
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>共同任务</h2>
          <span class="tag">双人共建</span>
        </div>
        <button type="button" id="newDuoTaskBtn" class="btn btn-primary btn-sm" hidden>+ 新建共同任务</button>
      </div>
      <div class="section-body" id="duoTaskBody"></div>
    </section>

    <!-- Day 9：共同任务 新建 / 编辑 弹窗 -->
    <div class="modal-overlay" id="duoTaskModal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="duoTaskModalTitle">
        <div class="modal-head">
          <h3 id="duoTaskModalTitle">新建共同任务</h3>
          <button type="button" class="modal-close" id="duoTaskModalClose" aria-label="关闭">×</button>
        </div>
        <form id="duoTaskForm" novalidate>
          <input type="hidden" id="duoTaskFormId" name="id" value="" />
          <div class="form-group">
            <label for="duoTaskTitle">任务标题</label>
            <input id="duoTaskTitle" name="title" type="text" maxlength="50"
                   placeholder="一句话描述任务，如：一起刷完近五年英语真题" />
            <p class="field-error" data-error-for="title"></p>
          </div>
          <div class="form-group">
            <label for="duoTaskDesc">任务说明（可选）</label>
            <textarea id="duoTaskDesc" name="description" maxlength="500"
                      placeholder="补充要求、教材范围、验收标准…"></textarea>
            <p class="field-error" data-error-for="description"></p>
          </div>
          <div class="form-group">
            <label for="duoTaskDeadline">截止时间（可选）</label>
            <input id="duoTaskDeadline" name="deadline" type="datetime-local" />
            <p class="field-error" data-error-for="deadline"></p>
          </div>
          <div class="form-group">
            <label for="duoDivisionA">成员 A 的分工（可选）<span class="muted duo-division-owner" id="duoDivisionAOwner"></span></label>
            <input id="duoDivisionA" name="division_a" type="text" maxlength="100"
                   placeholder="如：负责前两篇阅读 + 答案校对" />
            <p class="field-error" data-error-for="division_a"></p>
          </div>
          <div class="form-group">
            <label for="duoDivisionB">成员 B 的分工（可选）<span class="muted duo-division-owner" id="duoDivisionBOwner"></span></label>
            <input id="duoDivisionB" name="division_b" type="text" maxlength="100"
                   placeholder="如：负责后两篇阅读 + 错题整理" />
            <p class="field-error" data-error-for="division_b"></p>
          </div>
          <div class="alert alert-error" id="duoTaskFormError" hidden></div>
          <div class="modal-actions">
            <button type="button" class="btn btn-outline" id="duoTaskModalCancel">取消</button>
            <button type="submit" class="btn btn-primary">保存任务</button>
          </div>
        </form>
      </div>
    </div>
    <!-- Day 10：双人打卡记录（双方可见，可按任务筛选） -->
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>双人打卡记录</h2>
          <span class="tag">双方可见</span>
        </div>
      </div>
      <div class="section-body">
        <form class="history-filter" id="duoRecordFilter">
          <div class="form-group">
            <label for="duoRecordTask">按任务筛选</label>
            <select id="duoRecordTask" name="taskId">
              <option value="">全部任务</option>
            </select>
          </div>
          <div class="form-group history-filter-actions">
            <button type="submit" class="btn btn-primary btn-sm">筛选</button>
          </div>
        </form>
        <div id="duoRecordBody"></div>
      </div>
    </section>

    <!-- Day 10：协作动态（站内通知） -->
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>协作动态</h2>
          <span class="tag">最新 10 条</span>
        </div>
        <button type="button" id="notifReadAllBtn" class="btn btn-outline btn-sm" hidden>全部已读</button>
      </div>
      <div class="section-body" id="notifBody">
        <%- include('partials/components/loading', { text: '正在加载协作动态…' }) %>
      </div>
    </section>

    <!-- Day 10：双人打卡 弹窗 -->
    <div class="modal-overlay" id="duoCheckinModal" hidden>
      <div class="modal" role="dialog" aria-modal="true" aria-labelledby="duoCheckinModalTitle">
        <div class="modal-head">
          <h3 id="duoCheckinModalTitle">双人打卡</h3>
          <button type="button" class="modal-close" id="duoCheckinModalClose" aria-label="关闭">×</button>
        </div>
        <form id="duoCheckinForm" novalidate>
          <p class="duo-checkin-task" id="duoCheckinTaskName"></p>
          <p class="duo-checkin-division muted" id="duoCheckinMyDivision"></p>
          <div class="form-group">
            <label>上传照片 <span class="muted">（1–3 张，打卡凭证）</span></label>
            <button type="button" class="upload-zone" id="duoPhotoPickBtn" aria-haspopup="dialog">
              点击选择照片<br />
              <span class="upload-zone-sub">支持 JPG / PNG / JPEG，单张 ≤ 10MB，最多 3 张；每天最多打卡一次</span>
            </button>
            <input type="file" id="duoPhotoInput" accept="image/jpeg,image/png" multiple hidden />
            <div class="photo-preview" id="duoPhotoPreview" hidden></div>
            <p class="field-error" data-error-for="photos"></p>
          </div>
          <div class="form-group">
            <label for="duoCheckinNote">学习备注（可选）</label>
            <textarea id="duoCheckinNote" name="note" maxlength="500"
                      placeholder="记录今天的完成情况 / 遇到的问题（会展示在全员打卡广场）…"></textarea>
            <p class="field-error" data-error-for="note"></p>
          </div>
          <div class="alert alert-error" id="duoCheckinFormError" hidden></div>
          <div class="modal-actions">
            <button type="button" class="btn btn-outline" id="duoCheckinModalCancel">取消</button>
            <button type="submit" class="btn btn-primary">提交打卡</button>
          </div>
        </form>
      </div>
    </div>
    <script src="/js/duo.js" defer></script>
  <% } else { %>
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>我的搭档</h2>
          <span class="tag tag-duo">双人</span>
        </div>
      </div>
      <div class="section-body">
        <%- include('partials/components/empty', {
              emptyTitle: '登录后开始组队',
              emptyHint: '绑定一位学习搭档，互相监督、共同完成学习任务。',
              emptyActionText: '立即登录',
              emptyActionHref: '/login'
            }) %>
      </div>
    </section>
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>共同任务</h2>
          <span class="tag">双人共建</span>
        </div>
      </div>
      <div class="section-body">
        <%- include('partials/components/empty', {
              emptyTitle: '组队后即可共建任务',
              emptyHint: '共同任务支持双方分工、截止时间、状态流转与每日双方打卡。',
              emptyActionText: '立即登录',
              emptyActionHref: '/login'
            }) %>
      </div>
    </section>
    <section class="card section-card">
      <div class="section-head">
        <div class="section-title">
          <h2>双人打卡记录</h2>
          <span class="tag">双方可见</span>
        </div>
      </div>
      <div class="section-body">
        <%- include('partials/components/empty', {
              emptyTitle: '登录后查看打卡记录',
              emptyHint: '组队打卡后，双方的照片凭证与备注会展示在这里。',
              emptyActionText: '立即登录',
              emptyActionHref: '/login'
            }) %>
      </div>
    </section>
  <% } %>

<%- include('partials/footer') %>
