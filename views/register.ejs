<%- include('partials/header', { title, active: '' }) %>

  <section class="auth-wrap">
    <form id="authForm" class="card form-card" method="post" action="/api/auth/register">
      <h2>注册</h2>

      <div class="form-group">
        <label for="nickname">昵称</label>
        <input id="nickname" name="nickname" type="text" maxlength="20"
               placeholder="展示给别人看的名字，最多 20 个字符" required />
        <p class="field-error" data-error-for="nickname"></p>
      </div>

      <div class="form-group">
        <label for="account">账号</label>
        <input id="account" name="account" type="text" autocomplete="username"
               placeholder="3–24 位字母、数字或下划线" required />
        <p class="field-error" data-error-for="account"></p>
      </div>

      <div class="form-group">
        <label for="password">密码</label>
        <input id="password" name="password" type="password" autocomplete="new-password"
               placeholder="6–32 位，须同时包含字母和数字" required />
        <p class="field-error" data-error-for="password"></p>
      </div>

      <div class="form-group">
        <label for="confirmPassword">确认密码</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password"
               placeholder="再输入一遍密码" required />
        <p class="field-error" data-error-for="confirmPassword"></p>
      </div>

      <div class="alert alert-error" id="formError" hidden></div>

      <button type="submit" class="btn btn-primary btn-block">注 册</button>
      <p class="form-hint">已有账号？<a href="/login">去登录</a></p>
    </form>
  </section>

<%- include('partials/footer') %>
<script src="/js/auth.js"></script>
