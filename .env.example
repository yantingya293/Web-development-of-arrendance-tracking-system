# 服务端口
PORT=3000

# Session 签名密钥（生产必填：不设置时生产环境拒绝启动；开发环境未设置则每次启动随机生成、重启后登录态失效）
# 生成示例：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please_change_me_to_a_random_long_string

# 首次建库时种子管理员 admin 的密码（仅 users 表为空时生效；建库后请在「个人中心 → 修改密码」修改）
ADMIN_PASSWORD=please_change_me_too

# SQLite 数据库文件路径（Day2 引入）
DB_PATH=data/app.db

# 生产环境标记（=production 时：未设置 SESSION_SECRET 拒绝启动；会话 Cookie 走 HTTPS 才带 Secure 标志）
# NODE_ENV=production
